{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["stories", "open_questions"],
  "properties": {
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "need", "benefit", "acceptance_criteria"],
        "properties": {
          "id": {"type": "string", "pattern": "^US-[0-9]+$"},
          "role": {"type": "string", "minLength": 1},
          "need": {"type": "string", "minLength": 1},
          "benefit": {"type": "string", "minLength": 1},
          "acceptance_criteria": {
            "type": "array", "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
